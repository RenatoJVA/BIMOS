# ==============================================================================
#                     BIMOS ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file controls the global settings for the Biomolecular Modeling Suite.
# Changes here will be applied the next time you run `bimos` or the GUI.

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
BIMOS_HOST=127.0.0.1
BIMOS_PORT=8000
BIMOS_DEBUG=false
# local = run pipelines on this host; disabled = serve API/UI only (compose).
BIMOS_EXECUTION_MODE=local
# Required only when binding outside loopback (0.0.0.0, LAN, reverse proxy).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BIMOS_API_TOKEN=
# Optional native TLS. Set both paths to serve HTTPS directly from BIMOS.
# If TLS terminates in a reverse proxy, leave both empty.
# BIMOS_TLS_CERTFILE=/etc/bimos/tls/server.crt
# BIMOS_TLS_KEYFILE=/etc/bimos/tls/server.key

# ------------------------------------------------------------------------------
# 2. COMPUTATIONAL ENGINE (PODMAN / DOCKER)
# ------------------------------------------------------------------------------
BIMOS_IMAGE=localhost/bimos/global:latest
BIMOS_USE_GPU=true

# ------------------------------------------------------------------------------
# 3. DIRECTORY PATHS
# ------------------------------------------------------------------------------
BIMOS_WORKSPACE=${BIMOS_WORKSPACE}
BIMOS_CACHE=${BIMOS_CACHE}
BIMOS_LOGS=${BIMOS_LOGS}

# ------------------------------------------------------------------------------
# 4. DATABASE INTEGRATION
# ------------------------------------------------------------------------------
# Required only for the ligand database commands (bimos db ...).
# Use a unique password; the historical bimos/bimos default is not shipped.
# BIMOS_DATABASE_URL=postgresql+psycopg://bimos:CHANGE_ME@localhost/bimos

# ------------------------------------------------------------------------------
# 5. QUANTUM MECHANICS (HOST BINARIES)
# ------------------------------------------------------------------------------
ORCA_PATH=
GAUSSIAN_PATH=

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED EXECUTION (THIN CLIENT)
# ------------------------------------------------------------------------------
# BIMOS_REMOTE_URL=
# BIMOS_SSH_HOST=
# BIMOS_SSH_USER=
# BIMOS_SSH_KEY=
# ==============================================================================
