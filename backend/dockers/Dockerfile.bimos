# syntax=docker/dockerfile:1
#
# BIMOS Global Dockerfile
# Consolidates AutoDock Vina, GROMACS and Boltz-2 into a single image.
#
# Reproducibility contract:
#   * every external download is verified against a pinned SHA-256;
#   * every Python dependency is version-pinned;
#   * Boltz and Meeko come from PyPI, never from an unpinned git clone.
#
# Override any pin at build time, e.g.:
#   podman build --build-arg BOLTZ_VERSION=2.2.1 -t localhost/bimos/global:latest .

ARG CUDA_VERSION=13.1.1
ARG UBUNTU_SUFFIX=ubuntu24.04
ARG GROMACS_VERSION=2025.4
# sha256 of gromacs-2025.4.tar.gz from https://ftp.gromacs.org/gromacs/
# (md5 733448146f1f0555c9fd8d7a5d14ac7b, as published in the GROMACS docs)
ARG GROMACS_SHA256=ca17720b4a260eb73649211e9f6a940ee7543452129844213c3accb0a927a5c3
ARG VINA_VERSION=1.2.5
# sha256 of the official AutoDock-Vina v1.2.5 linux x86_64 release binary
ARG VINA_SHA256=fa0126a28a9ea9162d1b161dfa92bc76e632416db28ca246278ea4b2dc6860cb
ARG BOLTZ_VERSION=2.2.1
ARG TORCH_VERSION=2.14.1
ARG TORCH_CUDA_CHANNEL=cu130
# cuequivariance 0.6.1 was published 2025-09-04, four days before boltz 2.2.1
# (2025-09-08), so it is the release this image targets. Newer versions move
# months past the last version boltz was tested against.
ARG CUEQUIVARIANCE_VERSION=0.6.1
# Boltz imports cuequivariance lazily, only inside kernel_* functions, and
# boltz.yaml ships `no_kernels: true`. The stack is therefore opt-in: turn it on
# with --build-arg INSTALL_BOLTZ_KERNELS=ON to use `use_kernels: false`.
ARG INSTALL_BOLTZ_KERNELS=OFF
ARG MEEKO_VERSION=0.8.0
# BIMOS only ever invokes the single-precision `gmx` binary, so the optional
# double-precision build is off by default (it roughly doubles build time).
ARG GMX_DOUBLE=OFF

#################################################################
# Stage 1: GROMACS builder
#################################################################
FROM docker.io/nvidia/cuda:${CUDA_VERSION}-cudnn-devel-${UBUNTU_SUFFIX} AS gmx_builder

ARG GROMACS_VERSION
ARG GROMACS_SHA256
ARG GMX_DOUBLE

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ccache \
    ca-certificates \
    curl \
    libfftw3-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Fail the build on a corrupted or substituted tarball.
RUN set -eux; \
    curl -fsSL -o /tmp/gromacs.tar.gz \
      "https://ftp.gromacs.org/gromacs/gromacs-${GROMACS_VERSION}.tar.gz"; \
    echo "${GROMACS_SHA256}  /tmp/gromacs.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/gromacs-src; \
    tar xfz /tmp/gromacs.tar.gz -C /opt/gromacs-src --strip-components=1; \
    rm -f /tmp/gromacs.tar.gz

# GMX_BUILD_OWN_FFTW is OFF on purpose: GROMACS' own default. Turning it on
# makes CMake download and build FFTW from the internet mid-build, ignoring the
# system libfftw3-dev that this stage installs.
# GMX_MPI=OFF is explicit so `gmx` (not `gmx_mpi`) is what lands on PATH, which
# is the binary name the BIMOS MD pipeline invokes.
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    set -eux; \
    cmake -S /opt/gromacs-src -B /opt/gromacs-src/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_C_COMPILER_LAUNCHER=ccache \
      -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
      -DCMAKE_INSTALL_PREFIX=/usr/local/gromacs \
      -DGMX_GPU=CUDA \
      -DCUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda \
      -DGMX_OPENMP=ON \
      -DGMX_MPI=OFF \
      -DGMX_FFT_LIBRARY=fftw3 \
      -DGMX_BUILD_OWN_FFTW=OFF \
      -DGMX_PYTHON_PACKAGE=OFF \
      -DGMX_PREFER_STATIC_LIBS=ON \
      -DGMX_DEFAULT_SUFFIX=OFF \
      -DREGRESSIONTEST_DOWNLOAD=OFF; \
    cmake --build /opt/gromacs-src/build --parallel "$(nproc)"; \
    cmake --install /opt/gromacs-src/build; \
    rm -rf /opt/gromacs-src

# Optional second install for double precision. BIMOS never calls it.
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    if [ "${GMX_DOUBLE}" = "ON" ]; then \
      set -eux; \
      curl -fsSL -o /tmp/gromacs.tar.gz \
        "https://ftp.gromacs.org/gromacs/gromacs-${GROMACS_VERSION}.tar.gz"; \
      echo "${GROMACS_SHA256}  /tmp/gromacs.tar.gz" | sha256sum -c -; \
      mkdir -p /opt/gromacs-src; \
      tar xfz /tmp/gromacs.tar.gz -C /opt/gromacs-src --strip-components=1; \
      cmake -S /opt/gromacs-src -B /opt/gromacs-src/build-double \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER_LAUNCHER=ccache \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
        -DCMAKE_INSTALL_PREFIX=/usr/local/gromacs \
        -DGMX_GPU=OFF \
        -DGMX_OPENMP=ON \
        -DGMX_MPI=OFF \
        -DGMX_FFT_LIBRARY=fftw3 \
        -DGMX_BUILD_OWN_FFTW=OFF \
        -DGMX_PYTHON_PACKAGE=OFF \
        -DGMX_PREFER_STATIC_LIBS=ON \
        -DGMX_DOUBLE=ON \
        -DREGRESSIONTEST_DOWNLOAD=OFF; \
      cmake --build /opt/gromacs-src/build-double --parallel "$(nproc)"; \
      cmake --install /opt/gromacs-src/build-double; \
      rm -rf /opt/gromacs-src /tmp/gromacs.tar.gz; \
    fi

#################################################################
# Stage 2: runtime image
#################################################################
FROM docker.io/nvidia/cuda:${CUDA_VERSION}-cudnn-runtime-${UBUNTU_SUFFIX}

ARG BOLTZ_VERSION
ARG TORCH_VERSION
ARG TORCH_CUDA_CHANNEL
ARG CUEQUIVARIANCE_VERSION
ARG INSTALL_BOLTZ_KERNELS
ARG VINA_VERSION
ARG VINA_SHA256
ARG MEEKO_VERSION

LABEL org.opencontainers.image.title="BIMOS Global" \
      org.opencontainers.image.description="AutoDock Vina, GROMACS and Boltz-2 in one CUDA image" \
      org.opencontainers.image.licenses="MIT AND GPL-2.0-or-later AND LGPL-2.1-only AND Apache-2.0" \
      org.opencontainers.image.documentation="https://github.com/BIMOS-suite/BIMOS" \
      org.opencontainers.image.source="https://github.com/BIMOS-suite/BIMOS"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    GMX_MAXBACKUP=999 \
    PATH=/usr/local/gromacs/bin:/usr/local/bin:$PATH

# No compiler and no python3-dev: every dependency below ships a cp312 manylinux
# wheel or a pure-Python sdist (checked against PyPI, see the pins in this
# file), so the runtime never needs to build a C extension. The GROMACS builder
# stage above is the only place a toolchain exists.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3-pip \
    ca-certificates \
    curl \
    libfftw3-single3 \
    libfftw3-double3 \
    libgomp1 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# AutoDock Vina. Hard fail on a bad download: the previous `pip install vina`
# fallback needed Boost and SWIG, which are not in this image, so it turned a
# clear download error into a confusing build error.
RUN set -eux; \
    curl -fsSL -o /usr/local/bin/vina \
      "https://github.com/ccsb-scripps/AutoDock-Vina/releases/download/v${VINA_VERSION}/vina_${VINA_VERSION}_linux_x86_64"; \
    echo "${VINA_SHA256}  /usr/local/bin/vina" | sha256sum -c -; \
    chmod 0755 /usr/local/bin/vina; \
    /usr/local/bin/vina --version

COPY --from=gmx_builder /usr/local/gromacs /usr/local/gromacs
RUN echo "source /usr/local/gromacs/bin/GMXRC" >> /etc/bash.bashrc \
    && gmx --version

# PyTorch from the CUDA-matched channel. PyPI's default wheels are not pinned to
# a CUDA version, which made GPU support depend on build day.
RUN set -eux; \
    pip3 install --break-system-packages --no-cache-dir \
      --index-url "https://download.pytorch.org/whl/${TORCH_CUDA_CHANNEL}" \
      "torch==${TORCH_VERSION}"; \
    python3 -c "import sys,torch;c=sys.argv[1];e=c[2:-1]+'.'+c[-1];assert torch.version.cuda==e,f'want CUDA {e}, got {torch.version.cuda}';print('torch',torch.__version__,'cuda',torch.version.cuda)" \
      "${TORCH_CUDA_CHANNEL}"

# Chemistry stack. Boltz 2.2.1 requires numpy<2.0, which is why it is pinned here
# rather than left to the resolver.
RUN set -eux; \
    pip3 install --break-system-packages --no-cache-dir \
      "numpy==1.26.4" \
      "scipy==1.13.1" \
      "pandas==2.2.3" \
      "biopython==1.84" \
      "requests==2.32.3" \
      "types-requests==2.31.0.20240406" \
      "tqdm==4.67.1" \
      "rdkit==2024.09.6" \
      "gemmi==0.6.5" \
      "meeko==${MEEKO_VERSION}"

# Boltz from PyPI. The previous `git clone --depth 1` of main meant every image
# build could silently install a different release.
#
# `boltz==2.2.1` pins its own runtime dependencies exactly, so the resolver
# cannot drift. `pip3 check` below is what proves that: the chemistry pins above
# satisfy every one of those constraints, and the build fails loudly here rather
# than on a user's first prediction.
RUN set -eux; \
    pip3 install --break-system-packages --no-cache-dir \
      "boltz==${BOLTZ_VERSION}"; \
    pip3 check; \
    boltz --help > /dev/null; \
    boltz predict --help > /dev/null; \
    python3 -c "import boltz, numpy, torch; print('boltz ok; numpy', numpy.__version__)"

# Optional fused-triangular-attention kernels. The upstream `[cuda]` extra
# requests the CUDA 12 builds of these, which do not match the cu130 torch
# above, so the cu13 wheels are named explicitly.
#
# This is off by default: boltz.yaml sets `no_kernels: true`, and boltz only
# imports cuequivariance inside its kernel_* functions, so the plain torch path
# above is complete on its own. Enabling this makes predictions faster but is
# not covered by BIMOS' test suite, so it is a deliberate opt-in.
RUN set -eux; \
    if [ "${INSTALL_BOLTZ_KERNELS}" = "ON" ]; then \
      pip3 install --break-system-packages --no-cache-dir \
        "cuequivariance==${CUEQUIVARIANCE_VERSION}" \
        "cuequivariance-torch==${CUEQUIVARIANCE_VERSION}" \
        "cuequivariance-ops-cu13==${CUEQUIVARIANCE_VERSION}" \
        "cuequivariance-ops-torch-cu13==${CUEQUIVARIANCE_VERSION}"; \
      python3 -c "from cuequivariance_torch.primitives.triangle import triangle_attention, triangle_multiplicative_update; print('cuequivariance kernels ok')"; \
    fi

# Fail the build here rather than on the first prediction.
RUN set -eux; \
    pip3 check; \
    gmx --version; \
    vina --version; \
    python3 -c "import torch, boltz, meeko, rdkit, gemmi; print('imports ok')"

RUN mkdir -p /models /workspace /data /results
WORKDIR /workspace

CMD ["/bin/bash"]
