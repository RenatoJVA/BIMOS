# BIMOS Environment Configuration
# Copy this file to .env and fill in the values for your local setup.

# Server
BIMOS_HOST=127.0.0.1
BIMOS_PORT=8000
BIMOS_DEBUG=false
# local = run pipelines on this host; disabled = API/UI only.
BIMOS_EXECUTION_MODE=local
# Required when binding outside loopback. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
BIMOS_API_TOKEN=
# Optional native TLS; set both or leave both empty.
# BIMOS_TLS_CERTFILE=/etc/bimos/tls/server.crt
# BIMOS_TLS_KEYFILE=/etc/bimos/tls/server.key

# Container Image
BIMOS_IMAGE=bimos/global:latest
BIMOS_USE_GPU=true

# Database
# H-07: do not ship or keep the historical bimos/bimos default password.
# Set a unique local password before first use.
# BIMOS_DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@localhost/bimos

# Optional Docker Compose stack (API/UI + PostgreSQL only; never mounts the
# Docker socket and does not execute pipelines). Both variables are required
# by docker-compose.yml:
# BIMOS_DB_PASSWORD=CHANGE_ME
# BIMOS_API_TOKEN=CHANGE_ME

# QM Tools (Host Binaries)
# You can use $HOME or other environment variables here.
ORCA_PATH=$HOME/orca_6_0_1/orca
GAUSSIAN_PATH=/opt/g16/g16

# Remote / HPC Configuration
# If you want to connect your local GUI to a remote BIMOS server:
# BIMOS_REMOTE_URL=http://your-server-ip:8000

# If you want to use a remote Docker/Podman engine via SSH (Advanced):
# BIMOS_SSH_HOST=your-server-ip
# BIMOS_SSH_USER=username
# BIMOS_SSH_KEY=~/.ssh/id_rsa
